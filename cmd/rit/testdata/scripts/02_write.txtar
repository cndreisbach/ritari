exec rit note view decisions/auth-uses-jwt
cmp stdout want/auth.md
exec rit read decisions/auth-uses-jwt.md
cmp stdout want/auth.md

exec rit lint
stdout '^success: true$'
stdout '^rule: dangling-link$'
stdout '^message: links to notes/user-database-schema, which does not exist$'
! exec rit lint --strict
stdout '^success: false$'
stdout '^error: 2 warning\(s\) with --strict$'
stderr '^rit: 2 warning\(s\) with --strict$'

okflint kb

