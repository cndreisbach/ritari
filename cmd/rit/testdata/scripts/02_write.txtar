! stdout warning
cmp kb/decisions/auth-uses-jwt.md want/auth.md
cmp kb/log.md want/log.md
cmp kb/decisions/index.md want/decisions-index.md
grep '^\* \[Decisions\]\(/decisions/index.md\) \(`decision`\) - A choice made, with its rationale.$' kb/index.md

exec rit note read 'auth uses jwt'
stdout '^id: decisions/auth-uses-jwt$'
stdout '^trust: unverified$'
stdout '^generated_by: claude-code$'
stdout '^observations: \["\[decision\] Use JWT for stateless auth #security \[\^1\]"\]$'
stdout '^relations: \[depends_on -> notes/user-database-schema\]$'
