# Scenario 2: write and read back.
exec rit project init work $WORK/kb --default

exec rit note write --title 'Auth uses JWT' --type decision --description 'Stateless auth.' --tags auth,security --obs 'decision: Use JWT for stateless auth #security' --rel 'depends_on: User Database Schema' --source 'PR #1234 https://github.com/acme/api/pull/1234'
stdout '^status: created$'
stdout '^id: decisions/auth-uses-jwt$'
stdout '^path: .*/kb/decisions/auth-uses-jwt.md$'
stdout '^added_observations: 1$'
stdout '^added_relations: 1$'
