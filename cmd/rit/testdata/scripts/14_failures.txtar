# Scenario 14: failures in machine mode.
! exec rit search x
stdout '^success: false$'
stdout '^error: "no project specified and no default set \(try: rit project init <name> <path>\)"$'
stderr '^rit: no project specified'

exec rit project init work $WORK/kb --default
! exec rit note read nope
stdout '^success: false$'
stdout '^error: "?note not found: nope"?$'
stderr '^rit: note not found: nope$'

! exec rit -p ghost ls
stdout 'project "ghost" not found'

! exec rit -o toml ls
stderr '^rit: unknown output format "toml" \(want text, yaml, or json\)$'

! exec rit nonsense
stderr 'rit: '

env RITARI_OUTPUT=text
! exec rit note read nope
! stdout success
stderr 'note not found: nope'
