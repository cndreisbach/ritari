# Commands not covered by the numbered scenarios.
exec rit version
stdout '^success: true$'
stdout '^version: '

exec rit config author human:me@example.com
stdout '^status: set$'
exec rit config author
stdout '^author: human:me@example.com$'
grep '^author: human:me@example.com$' config.yaml

exec rit install skills
stdout '^installed: \[ritari, ritari-ingest, ritari-reflect\]$'
stdout '^outdated: \[\]$'
exists .agents/skills/ritari/SKILL.md
exists .agents/skills/ritari/references/writing.md
exec rit install skills
stdout '^installed: \[\]$'
stdout '^retired: \[\]$'
mkdir .agents/skills/ritari-old
cp steps.md .agents/skills/ritari-old/SKILL.md
exec rit install skills
stdout '^retired: \[ritari-old\]$'
stdout '^removed: \[\]$'
exists .agents/skills/ritari-old/SKILL.md
exec rit install skills -o text
stdout 'warning: .* has skills this version no longer ships: ritari-old \(use --cleanup to remove them\)'
exec rit install skills --cleanup
stdout '^retired: \[\]$'
stdout '^removed: \[ritari-old\]$'
! exists .agents/skills/ritari-old
exists .agents/skills/ritari/SKILL.md

# Upgrading from a version that shipped more skills: an edited core skill is
# reported as outdated, the dropped skills as retired.
mkdir .agents/skills/ritari-notes
cp steps.md .agents/skills/ritari-notes/SKILL.md
cp steps.md .agents/skills/ritari/SKILL.md
exec rit install skills
stdout '^installed: \[\]$'
stdout '^outdated: \[ritari\]$'
stdout '^retired: \[ritari-notes\]$'
exec rit install skills -o text
stdout 'warning: .* has skills that differ from this version: ritari \(use --force to update them\)'
exec rit install skills --force --cleanup
stdout '^installed: \[ritari\]$'
stdout '^outdated: \[\]$'
stdout '^removed: \[ritari-notes\]$'
! grep '^- \[ \] a$' .agents/skills/ritari/SKILL.md
grep '^name: ritari$' .agents/skills/ritari/SKILL.md

exec rit install skills --agent claude
exists .claude/skills/ritari/references/lint.md
! exec rit install skills --agent claude --dir x
stderr '--agent and --dir are alternatives; pass one'
! exec rit install skills --agent vim
stderr 'unknown agent "vim" \(known: agents, claude\); use --dir for anything else'
exec rit skills install --agent claude
stdout '^installed: \[\]$'

exec rit project init work $WORK/kb --default
stdin steps.md
exec rit note write --title 'Task one' --type task --meta state=open --content -
stdin ticked.md
exec rit note edit 'Task one' --op replace_section --section Steps --content -
stdout '^op: replace_section$'
grep '^- \[x\] a$' kb/tasks/task-one.md
exec rit note edit tasks/task-one --op find_replace --find='- [ ] b' --content='- [x] b' --count 1
grep '^- \[x\] b$' kb/tasks/task-one.md
! exec rit note edit tasks/task-one
stderr 'nothing to do'
exec rit note edit tasks/task-one --tags a,b --meta state=done
grep '^tags: \[a, b\]$' kb/tasks/task-one.md
grep '^state: done$' kb/tasks/task-one.md

exec rit recent --limit 1
stdout '^count: 1$'
stdout '^modified: '
exec rit ls tasks
stdout '^ids: \[tasks/task-one\]$'
exec rit -o text types
stdout '^decision  decisions/  A choice made, with its rationale.$'

okflint kb

-- steps.md --
# Steps
- [ ] a
- [ ] b
-- ticked.md --
- [x] a
- [ ] b
