# Scenario 12: trust tiers and stale verification.
exec rit project init work $WORK/kb --default
exec rit note write --title 'Auth uses JWT' --type decision --obs 'decision: x'
exec rit note verify decisions/auth-uses-jwt --by human:a@b.c
stdout '^status: verified$'
stdout '^by: human:a@b.c$'
stdout '^trust: human-reviewed$'
exec rit search --meta trust=human-reviewed
stdout '^count: 1$'
exec rit lint --rule stale-verification
! stdout 'rule: stale-verification'

env RITARI_TEST_NOW=2026-07-30T09:00:00Z
exec rit note write --title 'Auth uses JWT' --obs 'decision: y'
exec rit lint --rule stale-verification
stdout '^rule: stale-verification$'

exec rit note verify decisions/auth-uses-jwt --by process:nightly
stdout '^trust: human-reviewed$'
